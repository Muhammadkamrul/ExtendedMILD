    "delay_ms": 70.0, "loss_pct": 8.0, "cross": 4.0, "mimic": 0.35,
    "nl_api": 0.8, "nl_analytics": 0.8, "nl_telemetry": 0.8
  },
  "scale_bounds": {
    "api": [1.5, 15.0], "analytics": [2.0, 120.0], "telemetry": [1.5, 40.0], "victim": [1.5, 40.0],
    "burst": [1.0, 10.0], "delay_ms": [10.0, 250.0], "loss_pct": [1.0, 25.0], "cross": [1.0, 6.0]
  },

  "snet_sri_weights": {
    "snet": {"loss": 1.5, "excess_rtt": 0.35, "jitter": 0.60},
    "sri": {"http_fail": 100.0, "excess_rtt": 0.15, "loss": 0.50}
  },
  "weight_sweep_levels": [[0, 0], [10, 0.5], [25, 1.5], [45, 3], [70, 5], [100, 8], [140, 12]],
